# =============================================================================
# Quantum South Side - settings template
# =============================================================================
# 1. Copy this file to a new file named ".env" (same folder).
# 2. Fill in the values you need. Leave the rest empty.
# 3. NEVER commit ".env". It is already listed in .gitignore.
# This file (".env.example") holds NO real values, so it is safe to commit.
#
# On Vercel you do not use a file. Add the same names in
# Project Settings > Environment Variables instead (see docs/supabase-setup.md).
#
# Every setting is optional. With none of them set, the site still works as a
# guest-only site: no accounts, no chatbot AI, no job listings.
# =============================================================================


# ---- Accounts (Supabase) ----------------------------------------------------
# Where to find these: Supabase dashboard > your project. See docs/supabase-setup.md.

# Your project's address, like https://abcdefghijkl.supabase.co
SUPABASE_URL=

# The PUBLIC key (called "anon" key, or "publishable" key in newer projects).
# It is meant to be seen by browsers. The site hands it out through api/public-config.
# Row Level Security in the database is what keeps data private.
SUPABASE_ANON_KEY=

# The SECRET admin key ("service_role" or "secret" key). SERVER ONLY.
# It skips every privacy rule in the database. Never put it in browser code,
# in a JSON file, in a screenshot, or in the repo. The public site does not need it.
# Only server functions that do admin jobs (like deleting an account) may read it.
SUPABASE_SERVICE_ROLE_KEY=


# ---- AI helper (optional, server only) --------------------------------------
# Used by server functions that write summaries or power the chatbot.
# Leave empty to keep those features off.

# Which AI company's service to call.
LLM_PROVIDER=
# The secret key from that company. SERVER ONLY.
LLM_API_KEY=
# The model name for short summaries (a small, cheap model is fine).
LLM_MODEL_SUMMARY=
# The model name for chatbot answers.
LLM_MODEL_CHAT=


# ---- Job listings (optional, server only) -----------------------------------
# For the Career Center's live job listings. Leave empty to show none.

JOBS_API_APP_ID=
JOBS_API_KEY=


# ---- Local development only -------------------------------------------------
# Port for "npm run dev" (default 8000). Add it here only if you want another one.
# PORT=8000
